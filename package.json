    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.1",
    "multer": "^2.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
