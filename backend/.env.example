# ==============================================================================
# TrustVault Backend Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# Copy this file to .env and provide your actual secrets locally
# For Render deployment, configure these key-value pairs in the Render Dashboard
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in production, or local MongoDB for dev/test)
# Example Local: mongodb://127.0.0.1:27017/trustvault
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/trustvault?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trustvault

# JWT Configuration
# Generate a strong, random 64-character secret in production
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_jwt_signing
JWT_EXPIRES_IN=24h

# File Upload & Storage Configuration
# Storage path relative to backend root (isolated from public web server)
STORAGE_PATH=storage/documents
MAX_FILE_SIZE_BYTES=26214400 # 25 MB max limit

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
